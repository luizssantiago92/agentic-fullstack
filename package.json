    "prepublishOnly": "npm test"
  },
  "files": [
    "index.js",
    "lib/",
    "skills/",
    "rules/",
    "templates/",
    "gates/",
    "scripts/link-local-bin.mjs",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
