{
  "name": "@luizsantiago/fullstack-floor-map",
  "version": "0.4.1",
  "description": "Full Stack Floor Map companion for Spec Seatbelt — Floors layer Execute manuals plus a specialist skill catalog. Progressive loading, one layer per task.",
  "type": "module",
  "bin": {
    "fullstack-floor-map": "./index.js",
    "agentic-fullstack": "./index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "node scripts/link-local-bin.mjs",
    "test": "node --test test/install.test.js test/gate.test.js test/catalog.test.js test/specialist-smoke.test.js test/catalog-pin.test.js",
    "validate:skills": "node scripts/validate-layer-skills.mjs",
    "sync:catalog": "node scripts/sync-catalog-from-upstream.mjs",
    "demo:validate": "node scripts/demo-validate.mjs",
    "demo:local": "node scripts/demo-local.mjs --keep",
    "prepublishOnly": "npm test"
  },
  "files": [
    "index.js",
    "lib/",
    "skills/",
    "catalog/",
    "rules/",
    "templates/",
    "gates/validate_layer_routing.py",
    "scripts/link-local-bin.mjs",
    "NOTICE",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luizssantiago92/fullstack-floor-map.git"
  },
  "keywords": [
    "ai",
    "agent",
    "cursor",
    "claude",
    "spec-driven",
    "seatbelt",
    "floors",
    "fullstack",
    "frontend",
    "backend",
    "data",
    "analytics",
    "cli"
  ],
  "author": "luizsantiago",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@luizsantiago/spec-seatbelt": ">=2.2.0"
  },
  "peerDependenciesMeta": {
    "@luizsantiago/spec-seatbelt": {
      "optional": true
    }
  }
}
