    "cursor",
    "claude",
    "spec-driven",
    "harness",
    "fullstack",
    "frontend",
    "backend",
    "data",
    "analytics",
    "cli"
  ],
  "author": "luizsantiago",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@luizsantiago/agentic-harness": ">=0.7.0"
  },
